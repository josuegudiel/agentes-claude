{
  "name": "agentes-claude",
  "version": "0.1.0",
  "private": true,
  "description": "Agentes de browser automation para flujos de SaaS (E2E, seed, agentes productivos)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "agent:run": "tsx scripts/run-agent.ts",
    "agent:predict": "tsx scripts/run-predictive-agent.ts",
    "audit:geo": "tsx scripts/run-geo-audit.ts",
    "predict:up": "cd predictive-service && uv run uvicorn predictive_service.main:app --port 8765",
    "web:dev": "pnpm --filter agentes-claude-web dev",
    "web:build": "pnpm --filter agentes-claude-web build",
    "web:start": "pnpm --filter agentes-claude-web start",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "ai": "^4.0.0",
    "dotenv": "^16.4.5",
    "next": "^16.0.0",
    "node-html-parser": "^7.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.0.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
