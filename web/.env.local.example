# Copia este archivo a `web/.env.local` para personalizar la config local.
# Sin .env.local, la app usa todos estos valores como default.

# --- Opcion 1: setup local (todo open source en tu PC) ---
PREDICTIVE_SERVICE_URL=http://localhost:8765
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Opcion 2: setup cloud (Groq + Hugging Face Spaces) ---
# Descomentar y llenar las dos primeras lineas para que la app use Groq en vez
# de Ollama. Ver DEPLOY.md para crear estas credenciales.
#
# GROQ_API_KEY=gsk_TU_KEY_AQUI
# GROQ_MODEL=llama-3.1-8b-instant
# PREDICTIVE_SERVICE_URL=https://TU_USUARIO-timesfm-sidecar.hf.space

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
