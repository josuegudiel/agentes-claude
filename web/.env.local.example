# Copia este archivo a `web/.env.local` y ajusta si tus servicios
# corren en puertos distintos.

# Sidecar Python con TimesFM (uvicorn predictive_service.main:app)
PREDICTIVE_SERVICE_URL=http://localhost:8765

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
