# =============================================================================
# Configuracion del entorno. Copia este archivo a .env y rellena los valores.
# Validamos en boot con zod (src/core/config.ts) — si falta algo, falla rapido.
# =============================================================================

# --- App bajo test ---
BASE_URL=https://staging.tu-saas.com
ENVIRONMENT=staging

# --- Credenciales para flows e2e ---
# En CI: usa secrets del runner. En local: NUNCA commitees el .env real.
TEST_USER_EMAIL=qa-bot@tu-saas.com
TEST_USER_PASSWORD=changeme
TEST_TENANT_SLUG=demo

# Cuenta admin para seed scripts (opcional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Logging ---
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# --- Agentes LLM (solo si usas src/agents/) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-4-6

# --- Agente predictivo (TimesFM + Ollama, todo open source) ---
# Sidecar Python con TimesFM en predictive-service/. Levanta con:
#   cd predictive-service && uv sync && uv run uvicorn predictive_service.main:app --port 8765
PREDICTIVE_SERVICE_URL=http://localhost:8765
PREDICTIVE_SERVICE_TIMEOUT_MS=60000
# Ollama local para el razonamiento en lenguaje natural (Llama 3.1 / Qwen 2.5 / Mistral).
# Instala https://ollama.com y luego `ollama pull llama3.1:8b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=120000
# Cuantos puntos hacia el futuro predice TimesFM por defecto (max 512).
TIMESFM_HORIZON=24

# --- Playwright ---
# Cuantas pruebas en paralelo (CI suele estar limitado)
PW_WORKERS=4
# true en CI, false en local para ver el navegador
HEADLESS=true
