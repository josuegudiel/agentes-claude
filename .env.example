# =============================================================================
# Configuracion del entorno. Copia este archivo a .env y rellena los valores.
# Validamos en boot con zod (src/core/config.ts) — si falta algo, falla rapido.
# =============================================================================

# --- App bajo test ---
BASE_URL=https://staging.tu-saas.com
ENVIRONMENT=staging

# --- Credenciales para flows e2e ---
# En CI: usa secrets del runner. En local: NUNCA commitees el .env real.
TEST_USER_EMAIL=qa-bot@tu-saas.com
TEST_USER_PASSWORD=changeme
TEST_TENANT_SLUG=demo

# Cuenta admin para seed scripts (opcional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Logging ---
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# --- Agentes LLM (solo si usas src/agents/) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-4-6

# --- Playwright ---
# Cuantas pruebas en paralelo (CI suele estar limitado)
PW_WORKERS=4
# true en CI, false en local para ver el navegador
HEADLESS=true
